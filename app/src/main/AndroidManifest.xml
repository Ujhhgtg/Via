        </activity>

        <activity android:name=".CustomTab" android:exported="false" android:resizeableActivity="true" android:taskAffinity="${applicationId}.customtab" android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation" android:windowSoftInputMode="adjustResize|stateAlwaysHidden" android:persistableMode="persistNever" />

        <service android:name=".platform.CustomTabsConnectionService" android:exported="true">
            <intent-filter><action android:name="android.support.customtabs.action.CustomTabsService" /></intent-filter>
        </service>

        <receiver android:name=".platform.SearchWidgetProvider" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_search" />
        </receiver>

        <receiver android:name=".platform.TransparentSearchWidgetProvider" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_search_transparent" />
        </receiver>
    </application>
</manifest>
